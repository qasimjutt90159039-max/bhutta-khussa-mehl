# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bhutta-khussa-mehal

# Secret used to sign JWT tokens - use a long random string
JWT_SECRET=replace_this_with_a_long_random_secret

# Port for local development (Vercel ignores this and assigns its own)
PORT=5000

# Admin seed account (used by seed script to create the first admin)
ADMIN_EMAIL=admin@bhuttakhussamehal.com
ADMIN_PASSWORD=change_this_password

# Cloudinary (for product image uploads) - optional but recommended
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma separated list of allowed frontend origins for CORS
CLIENT_ORIGIN=http://localhost:3000
